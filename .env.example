# Environment Variables — Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to git!

# ── MongoDB ────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=<appName>

# ── Next Auth ──────────────────────────────────────
NEXTAUTH_SECRET=<generate with: openssl rand -hex 32>
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ── Cloudinary ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── TextBee SMS gateway (new request / payment alerts to admin) ──
TEXTBEE_API_KEY=<your-textbee-api-key>
SMS_ADMIN_NUMBER=0771234567
